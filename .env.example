# Copy to .env.local

# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (primary sign-in)
# Create OAuth client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: https://<host>/api/auth/callback/google
# Local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Strava (optional connection + legacy secondary sign-in)
AUTH_STRAVA_ID=your_strava_client_id
AUTH_STRAVA_SECRET=your_strava_client_secret

# Optional: explicit Auth.js URL in production
# AUTH_URL=https://your-domain.vercel.app

# Local only: one-click /dev/preview as a seeded demo runner (never set in prod)
# AUTH_DEV_BYPASS=1
